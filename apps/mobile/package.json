{
  "name": "@fintrack-pro/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --clear",
    "android:dev": "APP_ENV=development npx expo run:android --variant debug",
    "android:prod": "APP_ENV=production npx expo run:android --variant release",
    "ios:dev": "APP_ENV=development npx expo run:ios --configuration Debug",
    "ios:prod": "APP_ENV=production npx expo run:ios --configuration Release",
    "web": "expo start --web",
    "build:dev": "eas build --platform android --profile development",
    "build:prod": "eas build --platform android --profile production",
    "build:apk:dev": "APP_ENV=development npx expo run:android --variant debug --no-install",
    "build:apk:prod": "APP_ENV=production npx expo run:android --variant release --no-install",
    "install:apk:dev": "adb install android/app/build/outputs/apk/development/debug/app-development-debug.apk",
    "install:apk:prod": "adb install android/app/build/outputs/apk/production/release/app-production-release.apk"
  },
  "dependencies": {
    "@fintrack-pro/app": "0.1.0",
    "@fintrack-pro/features": "0.1.0",
    "@fintrack-pro/shared": "0.1.0",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@reduxjs/toolkit": "2.2.0",
    "@tanstack/react-query": "5.100.10",
    "expo": "56.0.5",
    "expo-build-properties": "56.0.17",
    "expo-linking": "56.0.12",
    "expo-router": "56.2.7",
    "expo-secure-store": "56.0.4",
    "expo-status-bar": "56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.25.2",
    "react-native-worklets": "0.8.3",
    "react-redux": "9.1.0"
  },
  "devDependencies": {
    "dotenv": "17.4.2",
    "fs-extra": "11.3.5",
    "nativewind": "4.2.4",
    "tailwindcss": "3.4.17"
  }
}
