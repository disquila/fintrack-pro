{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@fintrack/core/*": ["../../packages/core/src/*"],
      "@fintrack/ui/*": ["../../packages/ui-kit/src/*"]
